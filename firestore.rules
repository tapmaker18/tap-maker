rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Assigned exclusively by Firebase Admin after the trusted owner signs in.
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Normal members can use the studio only after Super Admin approval.
    function isApprovedMember() {
      return isSuperAdmin() || (
        isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }

    function isApprovedOwner(userId) {
      return isOwner(userId) && isApprovedMember();
    }

    match /profiles/{profileId} {
      allow read: if resource.data.status == 'published'
                  || isApprovedOwner(resource.data.userId)
                  || isSuperAdmin();
      allow create: if isApprovedMember()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if (isApprovedOwner(resource.data.userId)
                        && request.resource.data.userId == resource.data.userId)
                    || isSuperAdmin();
      allow delete: if isApprovedOwner(resource.data.userId) || isSuperAdmin();

      match /links/{linkId} {
        allow read: if get(/databases/$(database)/documents/profiles/$(profileId)).data.status == 'published'
                    || isApprovedOwner(get(/databases/$(database)/documents/profiles/$(profileId)).data.userId)
                    || isSuperAdmin();
        allow write: if isApprovedOwner(get(/databases/$(database)/documents/profiles/$(profileId)).data.userId)
                     || isSuperAdmin();
      }

      // Public visitors may add event documents, but cannot alter existing data.
      match /analytics/{docId} {
        allow read: if isApprovedOwner(get(/databases/$(database)/documents/profiles/$(profileId)).data.userId)
                    || isSuperAdmin();
        allow create: if true;
        allow update, delete: if isSuperAdmin();
      }
    }

    match /menus/{menuId} {
      allow read: if resource.data.status == 'published'
                  || isApprovedOwner(resource.data.userId)
                  || isSuperAdmin();
      allow create: if isApprovedMember()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if (isApprovedOwner(resource.data.userId)
                        && request.resource.data.userId == resource.data.userId)
                    || isSuperAdmin();
      allow delete: if isApprovedOwner(resource.data.userId) || isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();

      // Browser registrations can create only a harmless pending member record.
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'member'
                    && request.resource.data.aiScansLimit == 5
                    && request.resource.data.aiScansUsed == 0;

      // Members may only update contact details. RBAC lifecycle and quotas are
      // managed by the Firebase Admin API for the Super Admin only.
      allow update: if isSuperAdmin()
                    || (isOwner(userId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['businessName', 'contactName', 'phone', 'orderRef', 'lastLoginAt']));
      allow delete: if isSuperAdmin();
    }
  }
}
