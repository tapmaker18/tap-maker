rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'adriancalicdan2@gmail.com';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Profiles collection
    match /profiles/{profileId} {
      // Anyone can read published profiles (for public NFC links)
      // Authenticated users can read their own profiles
      // Super admin can read all
      allow read: if resource.data.status == 'published'
                  || isOwner(resource.data.userId)
                  || isAdmin();

      // Users can create profiles with their own userId
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      // Users can update/delete their own profiles; super admin can update/delete any
      allow update, delete: if isOwner(resource.data.userId)
                            || isAdmin();

      match /links/{linkId} {
        allow read: if get(/databases/$(database)/documents/profiles/$(profileId)).data.status == 'published'
                    || isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Profile Analytics events (views and clicks)
      // Anyone can write analytics events (public visitors scanning NFC/visiting link)
      // Only profile owner and admin can read analytics
      match /analytics/{docId} {
        allow read: if isOwner(get(/databases/$(database)/documents/profiles/$(profileId)).data.userId)
                    || isAdmin();
        allow write: if true;
      }
    }

    // Digital Menus collection (Restaurant/Café menus)
    match /menus/{menuId} {
      // Anyone can read published menus (for public customer QR/NFC access)
      // Authenticated users can read their own menus
      // Super admin can read all
      allow read: if resource.data.status == 'published'
                  || isOwner(resource.data.userId)
                  || isAdmin();

      // Users can create menus with their own userId
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      // Users can update/delete their own menus; super admin can manage all
      allow update, delete: if isOwner(resource.data.userId)
                            || isAdmin();
    }
  }
}
