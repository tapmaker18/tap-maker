rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{allPaths=**} {
      allow read: if true;
      // Writes are restricted to the Firebase Admin service until uploads are
      // moved to an owner-scoped path with validation rules.
      allow write: if request.auth != null && request.auth.token.role == 'super_admin';
    }
  }
}
